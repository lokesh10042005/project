# Copy to .env and replace every placeholder before running the stack.
# Generate a strong key with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-this-with-a-random-secret-at-least-32-characters-long

# Used by Docker Compose for the PostgreSQL container and API connection.
POSTGRES_PASSWORD=replace-this-with-a-unique-local-database-password

# For local development outside Docker, use localhost rather than "postgres".
DATABASE_URL=postgresql+asyncpg://aps_user:replace-this-with-a-unique-local-database-password@localhost:5432/ai_privacy_shield
